ENVIRONMENT=development
POSTGRES_DB=dormflow
POSTGRES_USER=dormflow
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://dormflow:replace-with-a-long-random-database-password@localhost:5432/dormflow
JWT_SECRET=replace-with-at-least-32-random-characters-before-release
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
INITIAL_OPERATOR_EMAIL=operator@example.com
INITIAL_OPERATOR_PASSWORD=replace-with-a-long-unique-password
INITIAL_OPERATOR_NAME=Yotoqxona operatori
TIMEZONE=Asia/Tashkent
ADMINS_CAN_ADJUST_BILLING=false
