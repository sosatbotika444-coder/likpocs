ENVIRONMENT=development
POSTGRES_DB=dormflow
POSTGRES_USER=dormflow
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://dormflow:replace-with-a-long-random-database-password@localhost:5432/dormflow
JWT_SECRET=replace-with-at-least-32-random-characters-before-release
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://dormflows.netlify.app
INITIAL_OPERATOR_EMAIL=operator@example.com
INITIAL_OPERATOR_PASSWORD=replace-with-a-long-unique-password
INITIAL_OPERATOR_NAME=Yotoqxona operatori
TIMEZONE=Asia/Tashkent
ADMINS_CAN_ADJUST_BILLING=false
PUBLIC_APP_URL=https://dormflows.netlify.app
# Keep this key server-side. Public applicants can choose the Dots vision model after explicit external-processing consent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_ENABLED=true
TESSERACT_CMD=tesseract
FILE_STORAGE_BACKEND=local
FILE_LOCAL_DIRECTORY=./private-files
FILE_RETENTION_DAYS=365
FILE_MAX_BYTES=10485760
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional first ADMIN / INVESTOR accounts (created once when both email and a 12+ character password are set).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator
INITIAL_INVESTOR_EMAIL=
INITIAL_INVESTOR_PASSWORD=
INITIAL_INVESTOR_NAME=Investor
# Telegram bot (create it with @BotFather). The token is server-only; run `python -m app.telegram_bot` as a separate worker.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLL_SECONDS=10
TELEGRAM_LINK_MINUTES=10
