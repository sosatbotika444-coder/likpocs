    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "esbuild": true
  }
